{
  "name": "@alint-js/setup",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "GitHub Action that runs alint on a pull request and publishes the result",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alint-dev/setup.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@moeru/eslint-config": "^0.1.0-beta.20",
    "@moeru/std": "^0.1.0-beta.20",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jiti": "^2.7.0",
    "pathe": "^2.0.3",
    "tinyexec": "^1.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vitest": "^4.1.10"
  }
}
